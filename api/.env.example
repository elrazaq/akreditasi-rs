# Server Configuration
PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# Neon PostgreSQL Database Connection
# DATABASE_URL: Neon pooled connection (PgBouncer mode, used for queries & Prisma Client)
DATABASE_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-example-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require&pgbouncer=true"

# DIRECT_URL: Neon direct connection (used for Prisma migrations and schema push)
DIRECT_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-example.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Authentication & Security
JWT_SECRET="dev-jwt-secret-key-akreditasi-starkes-2024"
JWT_EXPIRES_IN="1d"

